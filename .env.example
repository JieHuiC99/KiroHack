# Copy to .env (dev) — never commit .env. Vercel gets its own values (see references/deploy.md).

# --- Database -------------------------------------------------------------
# Local docker Postgres (npm run db:up)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Migrations use DIRECT_URL when set (Supabase: session/direct connection, port 5432)
# DIRECT_URL=
# "true" only for local dev: TypeORM auto-creates/alters tables from entities. Never in production.
DB_SYNC=true
# "true" for Supabase / any hosted Postgres that requires TLS
DATABASE_SSL=false

# --- Auth (Better Auth) ---------------------------------------------------
# Generate with: npx auth@latest secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Optional OAuth (create a GitHub OAuth app, callback: http://localhost:3000/api/auth/callback/github)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: where the venue monitor loads classroom CCTV from. {venue} becomes the venue id (uc-3-3, lt-5, jc-1, ...).
# Must be something a browser can show in an <img>: an MJPEG stream or a snapshot URL. Leave unset for the placeholder.
# NEXT_PUBLIC_CCTV_URL_TEMPLATE=http://nvr.campus.example/streams/{venue}.mjpg

# Roles. Comma-separated email addresses; anyone else who signs up is a student.
# The emergency team runs the alarm, the dashboard and the venue monitor. Responders accept help requests.
EMERGENCY_TEAM_EMAILS=team@example.com
RESPONDER_EMAILS=responder@example.com

# Shared key for classroom computers (nobody is signed in on them). Lets a PC read its room's alert and
# acknowledge it, nothing else. Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CLASSROOM_DEVICE_KEY=replace-me-with-a-long-random-string
