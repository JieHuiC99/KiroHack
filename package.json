{
  "name": "safeway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "typeorm": "tsx node_modules/typeorm/cli.js",
    "db:generate": "npm run typeorm -- migration:generate -d src/db/cli-data-source.ts",
    "db:migrate": "npm run typeorm -- migration:run -d src/db/cli-data-source.ts",
    "db:revert": "npm run typeorm -- migration:revert -d src/db/cli-data-source.ts",
    "db:seed": "tsx src/db/seed.ts",
    "docker:app": "docker compose --profile app up --build",
    "setup": "npm run db:up && npm run db:seed"
  },
  "dependencies": {
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "^0.2.2",
    "server-only": "^0.0.1",
    "three": "^0.187.0",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
