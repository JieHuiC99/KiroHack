# Loaded by Vitest (mode "test") and Playwright. Points at the throwaway app_test database.
# Safe to commit: contains no secrets.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_test
DB_SYNC=true
DATABASE_SSL=false
BETTER_AUTH_SECRET=test-secret-test-secret-test-secret-123
BETTER_AUTH_URL=http://localhost:3100

# Test accounts (e2e/golden-path.spec.ts signs these up) and a test device key. Not secrets.
EMERGENCY_TEAM_EMAILS=team@safeway.test
RESPONDER_EMAILS=ben@safeway.test
CLASSROOM_DEVICE_KEY=test-device-key-test-device-key
